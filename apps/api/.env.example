APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=Europe/Moscow

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=trade_union_lms
DB_USERNAME=trade_union_user
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
# For SQLite experiments, provide a SQLite-compatible schema and set:
# DB_DRIVER=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SPA_ORIGIN=https://lms.example.com
SESSION_COOKIE=tu_lms_session
SESSION_TTL=86400
SESSION_SECURE=true
TRUST_PROXY=false
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_DIR=/tmp/trade-union-lms-rate-limits
