{
  "name": "trade-union/lms-api",
  "description": "Lean production-ready PHP API for Trade Union LMS",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "TradeUnion\\Api\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/smoke.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
